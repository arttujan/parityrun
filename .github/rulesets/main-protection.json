{
  "name": "main: green CI, no force pushes or deletion",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "lint", "integration_id": 15368 },
          { "context": "pr title", "integration_id": 15368 },
          { "context": "test (ubuntu-latest, Python 3.10)", "integration_id": 15368 },
          { "context": "test (ubuntu-latest, Python 3.13)", "integration_id": 15368 },
          { "context": "test (windows-latest, Python 3.13)", "integration_id": 15368 }
        ]
      }
    }
  ],
  "bypass_actors": []
}
